{
  "name": "what-to-eat-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit",
    "test": "rm -rf /tmp/what-to-eat-tests && functions/api/node_modules/.bin/esbuild $(find shared functions -name '*.test.ts' -not -path '*/node_modules/*') --bundle --platform=node --target=node20 --format=cjs --outdir=/tmp/what-to-eat-tests --outbase=. && node --test '/tmp/what-to-eat-tests/**/*.test.js'"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.17.0",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.3"
  }
}

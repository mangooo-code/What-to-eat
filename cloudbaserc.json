{
  "version": "2.1",
  "envId": "{{env.ENV_ID}}",
  "functionRoot": "./backend/functions",
  "functions": [
    {
      "name": "api",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 10,
      "memorySize": 256,
      "installDependency": false,
      "envVariables": {
        "JWT_SECRET": "{{env.JWT_SECRET}}"
      }
    },
    {
      "name": "inventory",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 10,
      "memorySize": 256,
      "installDependency": false,
      "envVariables": {
        "ENV_ID": "{{env.ENV_ID}}",
        "DEV_USER_ID": "{{env.DEV_USER_ID}}",
        "CLOUDBASE_API_KEY": "{{env.CLOUDBASE_API_KEY}}",
        "JWT_SECRET": "{{env.JWT_SECRET}}"
      }
    },
    {
      "name": "members",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 10,
      "memorySize": 256,
      "installDependency": false,
      "envVariables": {
        "ENV_ID": "{{env.ENV_ID}}",
        "DEV_USER_ID": "{{env.DEV_USER_ID}}",
        "CLOUDBASE_API_KEY": "{{env.CLOUDBASE_API_KEY}}",
        "JWT_SECRET": "{{env.JWT_SECRET}}"
      }
    }
  ],
  "gateway": {
    "routes": [
      {
        "path": "/login",
        "target": "function:api",
        "enablePathTransmission": true,
        "enableAuth": false
      },
      {
        "path": "/inventory",
        "target": "function:inventory",
        "enablePathTransmission": true,
        "enableAuth": false
      },
      {
        "path": "/members",
        "target": "function:members",
        "enablePathTransmission": true,
        "enableAuth": false
      }
    ]
  },
  "database": {
    "type": "postgresql",
    "migrations": "./backend/sql/migrations"
  },
  "hosting": [
    {
      "name": "web",
      "root": "./frontend",
      "framework": "vite",
      "installCommand": "npm install",
      "buildCommand": "npm run build",
      "outputDir": "dist"
    }
  ]
}

{
  "version": "2.1",
  "envId": "{{env.ENV_ID}}",
  "database": {
    "type": "postgresql",
    "migrations": "./backend/sql/migrations"
  },
  "hosting": [
    {
      "name": "web",
      "root": "./frontend",
      "framework": "vite",
      "installCommand": "npm install",
      "buildCommand": "npm run build",
      "outputDir": "dist"
    }
  ]
}
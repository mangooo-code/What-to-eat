{
  "version": "2.0",
  "envId": "{{env.ENV_ID}}",
  "framework": {
    "name": "what-to-eat",
    "plugins": {
      "website": {
        "use": "@cloudbase/framework-plugin-website",
        "inputs": {
          "outputPath": "frontend/dist"
        }
      }
    },
    "requirement": {
      "addons": [
        {
          "type": "PostgreSQL",
          "name": "what-to-eat-postgresql",
          "tier": "base",
          "storageGB": 1
        }
      ]
    }
  }
}
